{
  "id": "doc-viewer",
  "name": "Document & PDF Viewer",
  "version": "2.0.0",
  "description": "Visualiseur de documents universel (PDF, Markdown avec rendu texte, code source et fichiers bureautiques)",
  "icon": "📄",
  "author": "SimpleGallery Team",
  "category": "viewer",
  "locales": {
    "fr": {
      "title": "Visionneuse de Documents & PDF",
      "description": "Visualiseur de documents universel (PDF, Markdown avec rendu texte, code source et fichiers bureautiques)"
    },
    "en": {
      "title": "Document & PDF Viewer",
      "description": "Universal document viewer (PDF, Markdown rendered text, source code and office files)"
    },
    "ja": {
      "title": "ドキュメント＆PDFビューアー",
      "description": "ユニバーサルドキュメントビューアー（PDF、Markdown、ソースコード、オフィスファイル）"
    }
  },
  "mimeTypes": [
    "application/pdf",
    "text/*",
    "application/json",
    "application/msword",
    "application/vnd.openxmlformats-officedocument.*"
  ],
  "extensions": [
    "pdf",
    "txt",
    "md",
    "markdown",
    "json",
    "csv",
    "xml",
    "html",
    "htm",
    "tex",
    "latex",
    "js",
    "css",
    "php",
    "py",
    "sh",
    "log",
    "ini",
    "sql",
    "yaml",
    "yml",
    "doc",
    "docx",
    "xls",
    "xlsx",
    "ppt",
    "pptx",
    "rtf",
    "odt"
  ],
  "entry": {
    "js": "viewer.js",
    "css": "viewer.css"
  },
  "capabilities": [
    "pdf-embed",
    "text-reader",
    "markdown-gfm",
    "html-preview",
    "latex-render",
    "clipboard-copy",
    "fullscreen"
  ],
  "commands": {
    "scroll": {
      "label": "Faire défiler vers ancre / section",
      "params": {
        "highlight": { "type": "text", "label": "Ancre / Sélecteur", "placeholder": "#chapitre-1" }
      }
    },
    "scrollTo": {
      "label": "Faire défiler vers page ou ancre (scrollTo)",
      "params": {
        "page": { "type": "text", "label": "Numéro de page ou Sélecteur (#ancre)", "placeholder": "1 ou #chapitre-1", "default": "1" }
      }
    },
    "searchText": {
      "label": "Rechercher et surligner un texte (searchText)",
      "params": {
        "string": { "type": "text", "label": "Texte à rechercher", "placeholder": "mot-clé..." },
        "scrollto": { "type": "select", "label": "Défiler vers le résultat", "options": [{ "value": "true", "label": "Oui" }, { "value": "false", "label": "Non" }], "default": "true" }
      }
    },
    "nextPage": {
      "label": "Page suivante",
      "params": {}
    },
    "prevPage": {
      "label": "Page précédente",
      "params": {}
    },
    "setTheme": {
      "label": "Changer le thème de lecture (setTheme)",
      "params": {
        "theme": { "type": "select", "label": "Thème", "options": [{ "value": "dark", "label": "Sombre (Nuit)" }, { "value": "light", "label": "Clair" }, { "value": "sepia", "label": "Sépia (Livre)" }], "default": "dark" }
      }
    },
    "toggleEdit": {
      "label": "Basculer mode édition (WYSIWYG)",
      "params": {}
    }
  }
}
