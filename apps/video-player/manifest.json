{
  "id": "video-player",
  "name": "Video & Video Wall Player",
  "version": "2.0.0",
  "icon": "🎬",
  "author": "SimpleGallery Team",
  "category": "player",
  "locales": {
    "fr": {
      "title": "Lecteur Vidéo & Mur Vidéo",
      "description": "Lecteur vidéo haute performance avec mode PiP flottant et mur vidéo multi-écrans synchronisé"
    },
    "en": {
      "title": "Video & Video Wall Player",
      "description": "High-performance video player with floating PiP and synchronized multi-screen video wall"
    },
    "ja": {
      "title": "動画＆ビデオウォールプレーヤー",
      "description": "高性能動画プレーヤー（フローティングPiPおよび同期マルチスクリーンビデオウォール）"
    }
  },
  "mimeTypes": [
    "video/*"
  ],
  "extensions": [
    "mp4",
    "webm",
    "mov",
    "m4v",
    "mkv",
    "vwall",
    "videowall"
  ],
  "entry": {
    "js": "player.js",
    "css": "player.css",
    "template": "template.php"
  },
  "capabilities": [
    "pip",
    "video-wall-sync",
    "multi-video"
  ],
  "commands": {
    "play": {
      "label": "Lecture",
      "params": {}
    },
    "pause": {
      "label": "Pause",
      "params": {}
    },
    "seek": {
      "label": "Aller à un temps précis",
      "params": {
        "time": { "type": "time", "label": "Instant (MM:SS ou sec)", "default": "00:00" }
      }
    },
    "setVolume": {
      "label": "Régler le volume",
      "params": {
        "volume": { "type": "number", "min": 0, "max": 1, "step": 0.1, "label": "Volume (0.0 - 1.0)", "default": 1 }
      }
    }
  }
}